# Template showing required backend env vars
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bookmyslot
JWT_SECRET=your_jwt_secret_here

# Email configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password

# CORS Configuration
FRONTEND_URL=http://localhost:5173
